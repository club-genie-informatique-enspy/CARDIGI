# backend/.env (Assurez-vous que ce fichier existe et contient ceci)

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cardigi

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1
DEBUG=True
ENVIRONMENT=development

# Security
SECRET_KEY=A_VERY_LONG_SECRET_KEY_FOR_DEV_DO_NOT_USE_IN_PROD
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ADMIN_CREATION_SECRET=your-super-secret-admin-key-change-me

# External API
EXTERNAL_API_URL=http://localhost:8080/api # URL temporaire
EXTERNAL_API_KEY=dummy-key-for-dev

# Firebase
FIREBASE_PROJECT_ID=test-cardigi
FIREBASE_STORAGE_BUCKET=test-cardigi.appspot.com
FIREBASE_CREDENTIALS_PATH=./dev-firebase-credentials.json # Fichier doit exister (même vide pour l'instant)

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.1.1:3000"]
# ... autres variables ...
